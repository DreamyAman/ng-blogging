{
  "name": "ng-blogging",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ng-blogging/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/ng-blogging",
        "browser": "apps/ng-blogging/src/main.ts",
        "tsConfig": "apps/ng-blogging/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ng-blogging/public"
          }
        ],
        "styles": [
          "apps/ng-blogging/src/styles.scss",
          "node_modules/bootstrap/dist/css/bootstrap.min.css"
        ],
        "scripts": [
          "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
        ]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/ng-blogging/src/environments/environment.ts",
              "with": "apps/ng-blogging/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/ng-blogging/src/environments/environment.ts",
              "with": "apps/ng-blogging/src/environments/environment.dev.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "local",
      "configurations": {
        "production": {
          "buildTarget": "ng-blogging:build:production"
        },
        "development": {
          "buildTarget": "ng-blogging:build:development"
        },
        "local": {
          "buildTarget": "ng-blogging:build:local"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ng-blogging:build",
        "port": 4200,
        "staticFilePath": "dist/apps/ng-blogging/browser",
        "spa": true
      }
    }
  }
}